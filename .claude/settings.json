{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(analysis/**)",
      "Write(analysis/**)",
      "Edit(scouting/**)",
      "Write(scouting/**)",
      "Edit(scripts/**)",
      "Write(scripts/**)",
      "Edit(CLAUDE.md)",
      "Edit(README.md)",
      "Edit(.gitignore)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(grep*)",
      "Bash(find*)"
    ]
  }
}
