{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "extraKnownMarketplaces": {
    "claude-community": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-community"
      }
    }
  },
  "enabledPlugins": {
    "html-plan@claude-community": true
  },
  "permissions": {
    "allow": [
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(analysis/**)",
      "Write(analysis/**)",
      "Edit(scouting/**)",
      "Write(scouting/**)",
      "Edit(linters/**)",
      "Write(linters/**)",
      "Edit(site/**)",
      "Write(site/**)",
      "Edit(CLAUDE.md)",
      "Edit(assets/CLAUDE.md)",
      "Edit(context/CLAUDE.md)",
      "Edit(README.md)",
      "Edit(.gitignore)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)"
    ]
  }
}
