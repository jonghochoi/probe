# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# Generated site + its build caches. Rebuildable from analysis/ by
# site/build-site.py, so the artifact is deployed from Actions rather than
# committed. node_modules/ holds the build-time KaTeX and webfont sources,
# installed on demand with `npm install --no-save`.
.site/
.site-cache/
site/builder/node_modules/
# …and anywhere else a stray `npm install` puts them.
node_modules/

# Agent worktrees. A subagent run with worktree isolation gets the repo checked
# out here so it can build and commit without touching this working tree.
.claude/worktrees/

# Editors
.vscode/
.idea/
*.swp
.DS_Store
