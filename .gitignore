# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# Foundry execution runtime — full upstream checkout + venv built on demand by
# scripts/ensure-foundry-runtime.sh so /audit can RUN a foundry's smoke test
# (impl §🧬). Per-checkout, multi-GB, rebuildable from the pinned commit; never
# committed. The committed surface stays the vendored read-only snapshot.
.foundry-runtime/

# Editors
.vscode/
.idea/
*.swp
.DS_Store

# humanize-korean scratch workspace — per-run experiment artifacts
# (detection JSON, rewrite drafts, audit reports). The only deliverable
# is the in-place rewrite of the target file; everything in _workspace/
# is ephemeral.
_workspace/
