+"""Config for the DPP-hand variant of PI0.5.
+
+Maps "Dexterous Point Policy" (arXiv:2606.10614) onto the pi05 base. This
+config only adds the *input-side hand-keypoint encoding* and the *fingertip
+contact channel* (Design §🧰 / paper §3.2-§3.3); the autoregressive keypoint
+decoder, PointNet object tokens, and IK deployment are out of base scope (see
+impl.md §🧱).
+"""
+
+from dataclasses import dataclass
+
+from lerobot.configs import PreTrainedConfig
+from lerobot.utils.constants import OBS_STR
+
+from .configuration_pi05 import PI05Config
+
+# Raw 6-keypoint hand observation lives under this observation key. The
+# data-pipeline step (processor_pi05_dpphand.py) flattens it to an 18-dim
+# vector for the hand projector. Fixed keypoint order, paper §3.3:
+#   (wrist, thumb, index, middle, ring, pinky).
+OBS_HAND_KEYPOINTS = OBS_STR + ".hand_keypoints"
+# Fine-tuning-only binary fingertip contact 5-vector, paper §3.2 indexed as
+#   [thumb, index, middle, ring, pinky]  (no wrist entry).
+OBS_CONTACT = OBS_STR + ".contact"
+
+
+@PreTrainedConfig.register_subclass("pi05_dpphand")
+@dataclass
+class PI05DPPHandConfig(PI05Config):
+    # ── Hand keypoint encoding (paper §3.3, Design 데이터 계약) ──────────────
+    # Six keypoints (wrist + five fingertips), 3D each → 18-dim concat.
+    n_hand_keypoints: int = 6
+    hand_keypoint_dim: int = 18  # = 3 * n_hand_keypoints
+    n_fingertips: int = 5  # contact is per-fingertip (no wrist)
+    # phi_hand projector hidden width. Paper says only "a hand projector
+    # phi_hand" (depth/width unspecified) — default below is ours.
+    hand_proj_hidden_dim: int = 1024
+    # Fixed keypoint / fingertip index order (load-bearing data contract).
+    hand_keypoint_order: tuple[str, ...] = (
+        "wrist",
+        "thumb",
+        "index",
+        "middle",
+        "ring",
+        "pinky",
+    )
+    fingertip_order: tuple[str, ...] = ("thumb", "index", "middle", "ring", "pinky")
+
+    # ── Contact channel (paper §3.3, Eq.(2); fine-tuning only) ──────────────
+    # Pretraining uses no contact channel (VITRA has no contact labels), so the
+    # default is off — turning it on reproduces the fine-tuning stage.
+    use_contact_channel: bool = False
+    # phi_contact is a two-layer MLP (paper §3.3, explicit); hidden width below
+    # is ours (paper-silent).
+    contact_proj_hidden_dim: int = 1024
+    # lambda in Eq.(2): L_ft = L_act + lambda * L_ct.
+    contact_loss_weight: float = 1.0
+    # Stop the contact-loss gradient at the backbone (paper §3.3): only the
+    # contact head learns from L_ct.
+    contact_head_detach: bool = True
+    # w_+ positive-class weight in BCE_{w+}. Paper §3.3 says "a positive-class
+    # weight that compensates for class imbalance" but gives no value — 1.0 is
+    # our default (paper-silent).
+    contact_pos_weight: float = 1.0
+
+    # Observation keys the data-pipeline step reads from / writes to.
+    hand_keypoint_key: str = OBS_HAND_KEYPOINTS
+    contact_key: str = OBS_CONTACT
+
+    def __post_init__(self):
+        super().__post_init__()
+
+        if self.hand_keypoint_dim != 3 * self.n_hand_keypoints:
+            raise ValueError(
+                f"hand_keypoint_dim ({self.hand_keypoint_dim}) must equal "
+                f"3 * n_hand_keypoints ({3 * self.n_hand_keypoints})"
+            )
+        if self.n_fingertips != self.n_hand_keypoints - 1:
+            raise ValueError(
+                f"n_fingertips ({self.n_fingertips}) must equal "
+                f"n_hand_keypoints - 1 ({self.n_hand_keypoints - 1}) (wrist is not a fingertip)"
+            )
+        if len(self.hand_keypoint_order) != self.n_hand_keypoints:
+            raise ValueError("hand_keypoint_order must list exactly n_hand_keypoints names")
+        if len(self.fingertip_order) != self.n_fingertips:
+            raise ValueError("fingertip_order must list exactly n_fingertips names")
+        if self.contact_loss_weight < 0:
+            raise ValueError(f"contact_loss_weight (lambda) must be >= 0, got {self.contact_loss_weight}")
+        if self.contact_pos_weight <= 0:
+            raise ValueError(f"contact_pos_weight (w_+) must be > 0, got {self.contact_pos_weight}")
