@@ -0,0 +1,254 @@
+#!/usr/bin/env python
+
+# Copyright 2025 Physical Intelligence and The HuggingFace Inc. team. All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""DPP-hand variant of PI0.5 (arXiv:2606.10614, "Dexterous Point Policy").
+
+This module grounds the paper's *input-side hand-keypoint encoding* and the
+*fingertip contact channel* onto the pi05 base via the behavior-preserving
+seams added to ``modeling_pi05.py`` (``_extra_prefix_tokens`` / ``_suffix_hook``
+/ ``_build_model``).
+
+Covered (paper §3.2-§3.3):
+  * phi_hand — 6-keypoint (18-dim) hand projector → one extra prefix token,
+    the pi05 analog of a continuous state token (pi05 itself folds state into
+    the prompt; here we re-introduce a learned continuous hand token).
+  * phi_contact — 2-layer MLP fusing the binary contact 5-vector into the hand
+    token, last linear zero-initialized so the pretrained hand token is
+    recovered exactly at the start of fine-tuning.
+  * psi_ct — contact head on the action-expert hidden states, with the
+    contact-loss gradient stopped at the backbone (``contact_head_detach``).
+  * Eq.(2) composite objective L_ft = L_act + lambda * L_ct.
+
+NOT covered (out of base scope, see impl.md §🧱 + §🚧): autoregressive keypoint
+rollout (pi05 decodes the action chunk in parallel via flow matching), the
+keypoint-trajectory *output* head (the base flow-matching action remains the
+decoder), PointNet object-geometry tokens, and the IK / contact-force
+deployment loop.
+"""
+
+import torch
+import torch.nn.functional as F  # noqa: N812
+from torch import Tensor, nn
+
+from .configuration_pi05_dpphand import PI05DPPHandConfig
+from .modeling_pi05 import PI05Policy, PI05Pytorch, get_gemma_config
+
+
+class HandKeypointEncoder(nn.Module):
+    """phi_hand (+ optional phi_contact) → one model-dim hand token.
+
+    Paper §3.3: the six hand keypoints share a fixed index
+    (wrist, thumb, index, middle, ring, pinky); their coordinates are
+    concatenated into an 18-dim vector and projected to the model dimension via
+    ``phi_hand``. During fine-tuning the binary contact 5-vector is mapped by a
+    two-layer MLP ``phi_contact`` (last linear zero-init) and *added* to the
+    hand embedding, forming a single contact-aware hand token.
+    """
+
+    def __init__(
+        self,
+        in_dim: int,
+        width: int,
+        hidden_dim: int,
+        n_fingertips: int = 5,
+        use_contact: bool = False,
+        contact_hidden_dim: int = 1024,
+    ):
+        super().__init__()
+        self.in_dim = in_dim
+        self.width = width
+        self.n_fingertips = n_fingertips
+        self.use_contact = use_contact
+
+        # phi_hand: 18 -> hidden -> width (paper says only "a hand projector";
+        # the 2-layer form is ours).
+        self.hand_proj = nn.Sequential(
+            nn.Linear(in_dim, hidden_dim),
+            nn.GELU(),
+            nn.Linear(hidden_dim, width),
+        )
+
+        # phi_contact: explicit 2-layer MLP (paper §3.3). The LAST linear is
+        # zero-initialized so phi_contact(c) == 0 at init and the pretrained
+        # hand token is recovered exactly when fine-tuning begins.
+        if use_contact:
+            self.contact_proj = nn.Sequential(
+                nn.Linear(n_fingertips, contact_hidden_dim),
+                nn.GELU(),
+                nn.Linear(contact_hidden_dim, width),
+            )
+            nn.init.zeros_(self.contact_proj[-1].weight)
+            nn.init.zeros_(self.contact_proj[-1].bias)
+        else:
+            self.contact_proj = None
+
+    def forward(self, hand_keypoints: Tensor, contact: Tensor | None = None) -> Tensor:
+        """(B, 6, 3) or (B, 18) hand keypoints [+ (B, 5) contact] → (B, width)."""
+        hand = hand_keypoints.reshape(hand_keypoints.shape[0], -1)
+        if hand.shape[-1] != self.in_dim:
+            raise ValueError(f"expected hand vector of dim {self.in_dim}, got {hand.shape[-1]}")
+        token = self.hand_proj(hand)
+        if self.use_contact and contact is not None:
+            token = token + self.contact_proj(contact.to(token.dtype))
+        return token
+
+
+class ContactHead(nn.Module):
+    """psi_ct — five logits per step (paper §3.3, default init).
+
+    Added in parallel to the base action head. Input is the action-expert
+    hidden state of shape (B, H, width_expert); output is (B, H, n_fingertips)
+    logits whose sigmoid is the per-fingertip contact probability.
+    """
+
+    def __init__(self, width: int, n_fingertips: int = 5):
+        super().__init__()
+        self.proj = nn.Linear(width, n_fingertips)
+
+    def forward(self, hidden: Tensor) -> Tensor:
+        return self.proj(hidden)
+
+
+def contact_bce_loss(logits: Tensor, target: Tensor, pos_weight: float = 1.0) -> Tensor:
+    """L_ct = BCE_{w+}(sigmoid(logits), target) (paper Eq.(2))."""
+    pw = torch.as_tensor(pos_weight, dtype=logits.dtype, device=logits.device)
+    return F.binary_cross_entropy_with_logits(logits, target.to(logits.dtype), pos_weight=pw)
+
+
+def composite_dpphand_loss(
+    main_loss: Tensor,
+    contact_logits: Tensor,
+    contact_target: Tensor,
+    contact_loss_weight: float = 1.0,
+    pos_weight: float = 1.0,
+) -> Tensor:
+    """L_ft = L_act + lambda * L_ct (paper Eq.(2)).
+
+    ``main_loss`` is the base policy's action objective (on pi05, the
+    flow-matching loss). With ``contact_loss_weight == 0`` this reduces exactly
+    to ``main_loss``.
+    """
+    ct = contact_bce_loss(contact_logits, contact_target, pos_weight)
+    return main_loss + contact_loss_weight * ct
+
+
+class PI05DPPHandPytorch(PI05Pytorch):
+    """PI05 core model + hand-keypoint token and contact head."""
+
+    def __init__(self, config: PI05DPPHandConfig, rtc_processor=None):
+        super().__init__(config, rtc_processor=rtc_processor)
+
+        prefix_width = get_gemma_config(config.paligemma_variant).width
+        expert_width = get_gemma_config(config.action_expert_variant).width
+
+        self.hand_encoder = HandKeypointEncoder(
+            in_dim=config.hand_keypoint_dim,
+            width=prefix_width,
+            hidden_dim=config.hand_proj_hidden_dim,
+            n_fingertips=config.n_fingertips,
+            use_contact=config.use_contact_channel,
+            contact_hidden_dim=config.contact_proj_hidden_dim,
+        )
+        self.contact_head = (
+            ContactHead(expert_width, config.n_fingertips) if config.use_contact_channel else None
+        )
+
+        # Per-step scratch set by the policy before the heavy forward.
+        self._pending_hand_keypoints: Tensor | None = None
+        self._pending_contact: Tensor | None = None
+        self._last_suffix_out: Tensor | None = None
+
+    # --- seam overrides -----------------------------------------------------
+    def _extra_prefix_tokens(self, reference_embedding: Tensor):
+        """Append the hand token to the pi05 prefix (input-side encoding)."""
+        if self._pending_hand_keypoints is None:
+            return None
+        token = self.hand_encoder(self._pending_hand_keypoints, self._pending_contact)
+        token = token.to(reference_embedding.dtype).unsqueeze(1)  # (B, 1, width)
+        pad = torch.ones(token.shape[0], 1, dtype=torch.bool, device=token.device)
+        return token, pad, [0]
+
+    def _suffix_hook(self, suffix_out: Tensor) -> None:
+        """Capture the action-expert hidden states for the contact head."""
+        self._last_suffix_out = suffix_out
+
+    # --- contact objective --------------------------------------------------
+    def contact_logits_from_suffix(self, suffix_out: Tensor) -> Tensor:
+        hidden = suffix_out.detach() if self.config.contact_head_detach else suffix_out
+        return self.contact_head(hidden)
+
+
+class PI05DPPHandPolicy(PI05Policy):
+    """PI05 policy with the DPP hand-keypoint token + contact channel."""
+
+    config_class = PI05DPPHandConfig
+    name = "pi05_dpphand"
+
+    def _build_model(self, config: PI05DPPHandConfig) -> PI05DPPHandPytorch:
+        return PI05DPPHandPytorch(config, rtc_processor=self.rtc_processor)
+
+    def _stash_hand_inputs(self, batch: dict[str, Tensor]) -> None:
+        self.model._pending_hand_keypoints = batch.get(self.config.hand_keypoint_key)
+        if self.config.use_contact_channel:
+            self.model._pending_contact = batch.get(self.config.contact_key)
+        else:
+            self.model._pending_contact = None
+        self.model._last_suffix_out = None
+
+    def _clear_hand_inputs(self) -> None:
+        self.model._pending_hand_keypoints = None
+        self.model._pending_contact = None
+        self.model._last_suffix_out = None
+
+    def forward(self, batch: dict[str, Tensor], reduction: str = "mean") -> tuple[Tensor, dict]:
+        self._stash_hand_inputs(batch)
+        try:
+            loss, loss_dict = super().forward(batch, reduction=reduction)
+
+            if (
+                self.config.use_contact_channel
+                and reduction == "mean"
+                and self.model._last_suffix_out is not None
+                and self.config.contact_key in batch
+            ):
+                logits = self.model.contact_logits_from_suffix(self.model._last_suffix_out)
+                target = batch[self.config.contact_key]
+                ct = contact_bce_loss(logits, target, self.config.contact_pos_weight)
+                loss = loss + self.config.contact_loss_weight * ct
+                loss_dict["contact_loss"] = ct.item()
+        finally:
+            self._clear_hand_inputs()
+
+        return loss, loss_dict
+
+    @torch.no_grad()
+    def predict_action_chunk(self, batch: dict[str, Tensor], **kwargs) -> Tensor:
+        self._stash_hand_inputs(batch)
+        try:
+            return super().predict_action_chunk(batch, **kwargs)
+        finally:
+            self._clear_hand_inputs()
+
+
+# Kept importable for downstream callers mirroring the base package surface.
+__all__ = [
+    "HandKeypointEncoder",
+    "ContactHead",
+    "contact_bce_loss",
+    "composite_dpphand_loss",
+    "PI05DPPHandPytorch",
+    "PI05DPPHandPolicy",
+]
