+"""Data-pipeline (data contract) for the DPP-hand PI0.5 variant.
+
+This is the "how the dataset is turned into model input" surface for the hand
+channel of arXiv:2606.10614 (paper §3.2-§3.3):
+
+  * Hand keypoints arrive as six 3D points in the *fixed* index order
+    (wrist, thumb, index, middle, ring, pinky). We concatenate them into the
+    18-dim vector consumed by ``phi_hand`` (``HandKeypointEncoder``).
+  * The fine-tuning-only contact channel is a binary 5-vector indexed as
+    [thumb, index, middle, ring, pinky]; we validate its shape/values so a bad
+    annotation fails loud rather than silently corrupting the contact head.
+
+The keypoints are world-frame metric coordinates (depth-lifted, paper §3.2). The
+paper specifies no normalization statistics for them, so this step performs no
+scaling — see impl.md §🚧.
+"""
+
+from dataclasses import dataclass
+from typing import Any
+
+import torch
+
+from lerobot.configs import PipelineFeatureType, PolicyFeature
+from lerobot.processor import (
+    AddBatchDimensionProcessorStep,
+    ProcessorStep,
+    ProcessorStepRegistry,
+)
+from lerobot.types import EnvTransition, TransitionKey
+
+from .configuration_pi05_dpphand import OBS_CONTACT, OBS_HAND_KEYPOINTS, PI05DPPHandConfig
+from .processor_pi05 import make_pi05_pre_post_processors
+
+
+def build_hand_keypoint_vector(keypoints: torch.Tensor, n_hand_keypoints: int = 6) -> torch.Tensor:
+    """Flatten six 3D hand keypoints into the 18-dim vector for ``phi_hand``.
+
+    Accepts ``(..., n_hand_keypoints, 3)`` or an already-flat ``(..., 3 * n)``.
+    The keypoint order is assumed fixed (wrist, thumb, index, middle, ring,
+    pinky) — this step does not reorder, it only validates and flattens.
+    """
+    expected = 3 * n_hand_keypoints
+    if keypoints.shape[-1] == 3 and keypoints.shape[-2:] == torch.Size([n_hand_keypoints, 3]):
+        return keypoints.reshape(*keypoints.shape[:-2], expected)
+    if keypoints.shape[-1] == expected:
+        return keypoints
+    raise ValueError(
+        f"hand keypoints must be (..., {n_hand_keypoints}, 3) or (..., {expected}); got {tuple(keypoints.shape)}"
+    )
+
+
+def validate_contact_vector(contact: torch.Tensor, n_fingertips: int = 5) -> torch.Tensor:
+    """Validate the binary fingertip contact vector (paper §3.2).
+
+    Last dim must be ``n_fingertips`` and every value must be in {0, 1}.
+    """
+    if contact.shape[-1] != n_fingertips:
+        raise ValueError(f"contact vector last dim must be {n_fingertips}; got {contact.shape[-1]}")
+    uniq = torch.unique(contact)
+    if not torch.all((uniq == 0) | (uniq == 1)):
+        raise ValueError("contact vector must be binary {0, 1}")
+    return contact
+
+
+@ProcessorStepRegistry.register(name="pi05_dpphand_keypoint_processor_step")
+@dataclass
+class Pi05DPPHandKeypointProcessorStep(ProcessorStep):
+    """Build the 18-dim hand vector (+ validate contact) for the policy."""
+
+    n_hand_keypoints: int = 6
+    n_fingertips: int = 5
+    use_contact: bool = False
+    hand_keypoint_key: str = OBS_HAND_KEYPOINTS
+    contact_key: str = OBS_CONTACT
+
+    def __call__(self, transition: EnvTransition) -> EnvTransition:
+        observation = transition.get(TransitionKey.OBSERVATION)
+        if not observation or self.hand_keypoint_key not in observation:
+            return transition
+
+        transition = transition.copy()
+        observation = dict(observation)
+
+        observation[self.hand_keypoint_key] = build_hand_keypoint_vector(
+            observation[self.hand_keypoint_key], self.n_hand_keypoints
+        )
+        if self.use_contact and observation.get(self.contact_key) is not None:
+            observation[self.contact_key] = validate_contact_vector(
+                observation[self.contact_key], self.n_fingertips
+            )
+
+        transition[TransitionKey.OBSERVATION] = observation
+        return transition
+
+    def get_config(self) -> dict[str, Any]:
+        return {
+            "n_hand_keypoints": self.n_hand_keypoints,
+            "n_fingertips": self.n_fingertips,
+            "use_contact": self.use_contact,
+            "hand_keypoint_key": self.hand_keypoint_key,
+            "contact_key": self.contact_key,
+        }
+
+    def transform_features(
+        self, features: dict[PipelineFeatureType, dict[str, PolicyFeature]]
+    ) -> dict[PipelineFeatureType, dict[str, PolicyFeature]]:
+        # Reshape-only; the feature description is unchanged at the contract level.
+        return features
+
+
+def make_pi05_dpphand_pre_post_processors(
+    config: PI05DPPHandConfig,
+    dataset_stats: dict[str, dict[str, torch.Tensor]] | None = None,
+):
+    """pi05 pipeline + the hand-keypoint data-contract step inserted up front.
+
+    The hand step runs right after the batch-dimension step so the 18-dim
+    reshape / contact validation happen before normalization and tokenization.
+    """
+    preprocessor, postprocessor = make_pi05_pre_post_processors(config, dataset_stats=dataset_stats)
+
+    hand_step = Pi05DPPHandKeypointProcessorStep(
+        n_hand_keypoints=config.n_hand_keypoints,
+        n_fingertips=config.n_fingertips,
+        use_contact=config.use_contact_channel,
+        hand_keypoint_key=config.hand_keypoint_key,
+        contact_key=config.contact_key,
+    )
+
+    insert_at = 0
+    for i, step in enumerate(preprocessor.steps):
+        if isinstance(step, AddBatchDimensionProcessorStep):
+            insert_at = i + 1
+            break
+    preprocessor.steps.insert(insert_at, hand_step)
+
+    return preprocessor, postprocessor
