+"""Config for the Bridge-Attention extension of pi0.5 (arXiv:2509.09372).
+
+Reproduction of VLA-Adapter's Bridge Attention *gating* mapped onto pi0.5's
+native dual-tower attention (impl §🪛, §⚙️): the action expert's attention to
+the VL prefix is scaled, per expert layer, by a learnable ``tanh(g)`` gate —
+the suffix-query x prefix-key logit block (VLA-Adapter ``attn_scores_adapter *
+ratio_g``). ``bridge_attention=False`` makes the policy behave exactly like
+vanilla pi0.5, so origin-vs-bridge is a single config flag with no
+training-script changes.
+"""
+
+from dataclasses import dataclass
+
+from lerobot.configs import PreTrainedConfig
+
+from .configuration_pi05 import PI05Config
+
+
+@PreTrainedConfig.register_subclass("pi05_bridge")
+@dataclass
+class PI05BridgeConfig(PI05Config):
+    # Toggle: False -> vanilla pi0.5; True -> VLA-Adapter bridge gating on the
+    # action expert's attention to the VL prefix.
+    bridge_attention: bool = False
+
+    # Per-expert-layer gate init g, applied as tanh(g) to the suffix->prefix
+    # attention logits. 0.0 = VLA-Adapter faithful (bridge neutralized at init,
+    # tanh(0)=0, opens during training). When warm-starting from a pretrained
+    # pi05 checkpoint, set high (e.g. 4.0, tanh~0.999) so the expert starts
+    # ~identical to vanilla pi0.5 and learns to *modulate* the bridge instead.
+    bridge_gate_init: float = 0.0
+
+    def __post_init__(self):
+        super().__post_init__()
