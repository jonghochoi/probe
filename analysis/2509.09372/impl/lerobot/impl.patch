+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Bridge Attention on pi0.5 — gate-only port of VLA-Adapter (arXiv:2509.09372).
+
+VLA-Adapter's Bridge Attention learns, per policy block, a scalar
+``gating_factor`` (init 0 -> ``tanh`` -> ``ratio_g``) that scales how strongly
+the action query attends to a conditioning stream
+(``MLPResNetBlock``: ``attn_scores_adapter * ratio_g``). This module maps that
+*gating* idea onto pi0.5's native dual-tower attention while keeping the pi0.5
+backbone + flow-matching action expert intact (impl §⚙️):
+
+  - a learnable gate ``g_i`` per expert layer scales the suffix(action)-query x
+    prefix(VL)-key logit block by ``tanh(g_i)`` before softmax
+    (``gated_eager_attention`` in ``modeling_pi05``);
+  - at init ``g_i = bridge_gate_init`` (default 0 -> bridge neutralized,
+    VLA-Adapter faithful; set high to warm-start from a vanilla pi05 checkpoint).
+
+Training reuses pi0.5's fused ``compute_layer_complete`` (both towers
+concatenated), so the gate applies directly. Inference does NOT use pi0.5's
+KV-cache decode (which runs the expert standalone and would bypass the gate);
+instead it caches only the embedded prefix and re-runs the *fused* gated forward
+each denoise step, guaranteeing train/inference parity with one implementation.
+The KV-cache fast path is left as remaining work (impl §🚧).
+
+``bridge_attention=False`` defers entirely to vanilla pi0.5.
+"""
+
+import torch
+from torch import Tensor, nn
+
+from .configuration_pi05_bridge import PI05BridgeConfig
+from .modeling_pi05 import (
+    PaliGemmaWithExpertModel,
+    PI05Policy,
+    PI05Pytorch,
+    get_gemma_config,
+    make_att_2d_masks,
+)
+
+
+class PaliGemmaWithExpertModelBridge(PaliGemmaWithExpertModel):
+    """PaliGemma-with-expert whose action expert attends to the VL prefix through
+    a learnable per-layer gate (VLA-Adapter Bridge Attention, gate-only)."""
+
+    def __init__(self, *args, bridge_gate_init: float = 0.0, **kwargs):
+        super().__init__(*args, **kwargs)
+        expert_depth = len(self.gemma_expert.model.layers)
+        # One scalar gate per expert layer; tanh-mapped at use. Trained as a
+        # normal parameter (not frozen by freeze_vision_encoder/train_expert_only).
+        self.bridge_gates = nn.ParameterList(
+            [nn.Parameter(torch.tensor(float(bridge_gate_init))) for _ in range(expert_depth)]
+        )
+
+    def _bridge_gate(self, layer_idx):
+        return torch.tanh(self.bridge_gates[layer_idx])
+
+
+class PI05BridgePytorch(PI05Pytorch):
+    """pi0.5 core model with the optional VLA-Adapter bridge-attention gate."""
+
+    def __init__(self, config: PI05BridgeConfig, rtc_processor=None):
+        super().__init__(config, rtc_processor=rtc_processor)
+        self.config: PI05BridgeConfig = config
+
+    def _build_paligemma_with_expert(self, paligemma_config, action_expert_config):
+        if not self.config.bridge_attention:
+            # Vanilla pi0.5 backbone (no gates) — exact origin behavior.
+            return super()._build_paligemma_with_expert(paligemma_config, action_expert_config)
+        return PaliGemmaWithExpertModelBridge(
+            paligemma_config,
+            action_expert_config,
+            use_adarms=[False, True],
+            precision=self.config.dtype,
+            image_size=self.config.image_resolution[0],
+            freeze_vision_encoder=self.config.freeze_vision_encoder,
+            train_expert_only=self.config.train_expert_only,
+            bridge_gate_init=self.config.bridge_gate_init,
+        )
+
+    @torch.no_grad()
+    def sample_actions(
+        self, images, img_masks, tokens, masks, noise=None, num_steps=None, **kwargs
+    ) -> Tensor:
+        """Flow-matching inference with a gate-consistent fused forward.
+
+        Unlike vanilla pi0.5 (prefix KV-cache + standalone expert decode, which
+        bypasses the bridge gate), this caches only the *embedded* prefix and
+        re-runs the fused gated forward over ``[prefix; suffix]`` each denoise
+        step, so the gate applies exactly as in training. Cost: the transformer
+        layers recompute per step (the SigLIP vision tower runs once).
+        """
+        if not self.config.bridge_attention:
+            return super().sample_actions(
+                images, img_masks, tokens, masks, noise=noise, num_steps=num_steps, **kwargs
+            )
+
+        if num_steps is None:
+            num_steps = self.config.num_inference_steps
+
+        bsize = tokens.shape[0]
+        device = tokens.device
+
+        if noise is None:
+            actions_shape = (bsize, self.config.chunk_size, self.config.max_action_dim)
+            noise = self.sample_noise(actions_shape, device)
+
+        # Embed the VL prefix once (vision tower runs a single time).
+        prefix_embs, prefix_pad_masks, prefix_att_masks = self.embed_prefix(
+            images, img_masks, tokens, masks
+        )
+
+        dt = -1.0 / num_steps
+        x_t = noise
+        for step in range(num_steps):
+            time = 1.0 + step * dt
+            time_tensor = torch.tensor(time, dtype=torch.float32, device=device).expand(bsize)
+
+            def denoise_step_partial_call(input_x_t, current_timestep=time_tensor):
+                return self._bridge_denoise_step(
+                    prefix_embs=prefix_embs,
+                    prefix_pad_masks=prefix_pad_masks,
+                    prefix_att_masks=prefix_att_masks,
+                    x_t=input_x_t,
+                    timestep=current_timestep,
+                )
+
+            if self._rtc_enabled():
+                inference_delay = kwargs.get("inference_delay")
+                prev_chunk_left_over = kwargs.get("prev_chunk_left_over")
+                execution_horizon = kwargs.get("execution_horizon")
+
+                v_t = self.rtc_processor.denoise_step(
+                    x_t=x_t,
+                    prev_chunk_left_over=prev_chunk_left_over,
+                    inference_delay=inference_delay,
+                    time=time,
+                    original_denoise_step_partial=denoise_step_partial_call,
+                    execution_horizon=execution_horizon,
+                )
+            else:
+                v_t = denoise_step_partial_call(x_t)
+
+            x_t = x_t + dt * v_t
+
+            if self.rtc_processor is not None and self.rtc_processor.is_debug_enabled():
+                self.rtc_processor.track(time=time, x_t=x_t, v_t=v_t)
+
+        return x_t
+
+    def _bridge_denoise_step(self, prefix_embs, prefix_pad_masks, prefix_att_masks, x_t, timestep):
+        """One denoising step via a fused (gated) ``[prefix; suffix]`` forward."""
+        suffix_embs, suffix_pad_masks, suffix_att_masks, adarms_cond = self.embed_suffix(x_t, timestep)
+
+        if (
+            self.paligemma_with_expert.paligemma.model.language_model.layers[0].self_attn.q_proj.weight.dtype
+            == torch.bfloat16
+        ):
+            suffix_embs = suffix_embs.to(dtype=torch.bfloat16)
+            prefix_embs = prefix_embs.to(dtype=torch.bfloat16)
+
+        pad_masks = torch.cat([prefix_pad_masks, suffix_pad_masks], dim=1)
+        att_masks = torch.cat([prefix_att_masks, suffix_att_masks], dim=1)
+
+        att_2d_masks = make_att_2d_masks(pad_masks, att_masks)
+        position_ids = torch.cumsum(pad_masks, dim=1) - 1
+        att_2d_masks_4d = self._prepare_attention_masks_4d(att_2d_masks)
+
+        self.paligemma_with_expert.paligemma.model.language_model.config._attn_implementation = "eager"  # noqa: SLF001
+        self.paligemma_with_expert.gemma_expert.model.config._attn_implementation = "eager"  # noqa: SLF001
+
+        (_, suffix_out), _ = self.paligemma_with_expert.forward(
+            attention_mask=att_2d_masks_4d,
+            position_ids=position_ids,
+            past_key_values=None,
+            inputs_embeds=[prefix_embs, suffix_embs],
+            use_cache=False,
+            adarms_cond=[None, adarms_cond],
+        )
+
+        suffix_out = suffix_out[:, -self.config.chunk_size :]
+        suffix_out = suffix_out.to(dtype=torch.float32)
+        return self.action_out_proj(suffix_out)
+
+
+class PI05BridgePolicy(PI05Policy):
+    """pi0.5 policy variant exposing the VLA-Adapter bridge-attention reproduction.
+
+    Reuses pi0.5 processors (selected via ``isinstance(cfg, PI05Config)`` in the
+    policy factory) and the pi0.5 training/inference contracts unchanged.
+    """
+
+    config_class = PI05BridgeConfig
+    name = "pi05_bridge"
+
+    def _build_model(self, config: PI05BridgeConfig) -> PI05BridgePytorch:
+        return PI05BridgePytorch(config, rtc_processor=self.rtc_processor)
+
+
+def gate_count_for(action_expert_variant: str) -> int:
+    """Number of bridge gates a config implies (one per action-expert layer).
+
+    Exposed for the smoke test so it can assert the gate count without building
+    the heavy PaliGemma backbone.
+    """
+    return get_gemma_config(action_expert_variant).depth
