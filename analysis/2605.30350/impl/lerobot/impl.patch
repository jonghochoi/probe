+from dataclasses import dataclass
+
+from lerobot.configs import PreTrainedConfig
+
+from .configuration_pi05 import PI05Config
+
+
+@PreTrainedConfig.register_subclass("pi05_dynaflip")
+@dataclass
+class PI05DynaflipConfig(PI05Config):
+    """PI0.5 + DynaFLIP frozen-injection (PVI) variant.
+
+    Faithful mapping of DynaFLIP's VLA integration (arXiv:2605.30350 §3.4 /
+    appendix), which adopts plug-in visual injection (PVI, arXiv:2603.12772):
+
+      * an auxiliary visual encoder (DynaFLIP, frozen) emits **patch-token
+        sequences** per camera view;
+      * a zero-initialized **projection** maps those tokens to the action
+        expert's hidden width;
+      * a **trainable copy of the action expert** (initialized from the
+        pretrained expert, conditioned on the projected aux tokens) produces
+        per-layer hidden states;
+      * **zero-initialized per-layer injectors** add the copy-branch hidden as
+        a residual into the frozen main action expert at every layer.
+
+    Frozen: SigLIP / VLM / LLM / main action expert / aux encoder. Trained:
+    projection + copy-branch + per-layer injectors. Zero-init projection &
+    injectors make the policy identical to base pi0.5 at init; the visual
+    signal is learned in. Defaults reproduce vanilla PI05 (``inject_dynaflip
+    =False``).
+    """
+
+    # Master switch. False -> identical to PI05.
+    inject_dynaflip: bool = False
+    # Per-token feature dim of the auxiliary DynaFLIP patch tokens.
+    # DINOv2-Base patch-token width = 768. See analysis/2605.30350/design.md.
+    dynaflip_feature_dim: int = 768
+    # Batch key carrying the precomputed frozen DynaFLIP patch tokens,
+    # shape (B, L, dynaflip_feature_dim) with L = views * patches.
+    dynaflip_feature_key: str = "observation.dynaflip_feature"
+
+    def __post_init__(self):
+        super().__post_init__()
+        if self.dynaflip_feature_dim <= 0:
+            raise ValueError(
+                f"dynaflip_feature_dim must be positive, got {self.dynaflip_feature_dim}"
+            )
