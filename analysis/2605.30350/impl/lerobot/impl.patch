+# limitations under the License.
+
+from dataclasses import dataclass
+
+from lerobot.configs import PreTrainedConfig
+
+from .configuration_pi05 import PI05Config
+
+
+@PreTrainedConfig.register_subclass("pi05_dynaflip")
+@dataclass
+class PI05DynaflipConfig(PI05Config):
+    """PI0.5 + DynaFLIP frozen-injection (PVI) variant.
+
+    Adds a frozen auxiliary visual branch (DynaFLIP, arXiv:2605.30350 §3.4)
+    whose precomputed feature is projected into prefix tokens and appended to
+    the SigLIP image / language tokens. The SigLIP encoder, VLM and LLM stay
+    untouched, so the base model's prior is preserved. Defaults reproduce
+    vanilla PI05 behavior (``inject_dynaflip=False``).
+    """
+
+    # Master switch. False -> identical to PI05.
+    inject_dynaflip: bool = False
+    # DynaFLIP image-encoder feature dim: DINOv2-B CLS(768) (+) patch-mean(768).
+    # See analysis/2605.30350/design.md (data contract, intermediate feature).
+    dynaflip_feature_dim: int = 1536
+    # Number of injected prefix tokens. The paper delegates PVI internals to
+    # ref [60] (design.md unresolved); default 1 = the single pooled transition
+    # embedding z_I.
+    dynaflip_num_tokens: int = 1
+    # Batch key carrying the precomputed frozen DynaFLIP feature.
+    dynaflip_feature_key: str = "observation.dynaflip_feature"
+
+    def __post_init__(self):
+        super().__post_init__()
+        if self.dynaflip_feature_dim <= 0:
+            raise ValueError(
+                f"dynaflip_feature_dim must be positive, got {self.dynaflip_feature_dim}"
+            )
+        if self.dynaflip_num_tokens < 1:
+            raise ValueError(
+                f"dynaflip_num_tokens must be >= 1, got {self.dynaflip_num_tokens}"
+            )
