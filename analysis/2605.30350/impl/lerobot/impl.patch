@@ -0,0 +1,121 @@
+#!/usr/bin/env python
+
+# Copyright 2025 Physical Intelligence and The HuggingFace Inc. team. All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""PI0.5 + DynaFLIP frozen-injection (PVI) variant.
+
+Maps the downstream integration of DynaFLIP (arXiv:2605.30350 §3.4) onto the
+lerobot pi05 base. DynaFLIP adopts "a lightweight visual-injection design
+similar to plug-in visual injection (PVI) [arXiv:2603.12772]: an additional
+visual branch encodes features from the pre-trained image encoder, and an
+injection module projects them into the hidden feature space of the diffusion
+transformer of pi0.5" (§3.4).
+
+Accordingly the injection target here is the **action-expert (diffusion
+transformer) hidden space**, not the VLM prefix: a frozen DynaFLIP feature is
+projected by a **zero-initialized** linear map and added residually to the
+action-token hidden states (PVI's zero-init residual principle -> identity at
+init, learned during fine-tune). The SigLIP encoder / VLM / LLM / main expert
+stay untouched (prior-preserving).
+
+All DynaFLIP *pretraining* (simplex alignment, TCN, actor losses, 3D-flow
+encoder) is out-of-base-scope: the feature arrives precomputed in the batch
+under ``config.dynaflip_feature_key``.
+
+Fidelity note — full PVI [60] threads a trainable copy-branch DiT and a
+zero-init injection layer Z_i into *every* expert block. The lerobot inference
+path runs the expert through HF's fused ``gemma_expert.model.forward`` (no
+per-layer hook), so the per-layer copy-branch is not cleanly insertable for
+both train and inference. This module implements DynaFLIP's own "lightweight"
+reading — a single zero-init residual at the shared expert-input site
+(``embed_suffix``) that both paths traverse. See impl.md §🚧.
+"""
+
+import torch
+from torch import Tensor, nn
+
+from .configuration_pi05_dynaflip import PI05DynaflipConfig
+from .modeling_pi05 import PI05Policy, PI05Pytorch, get_gemma_config
+
+
+class DynaflipExpertInjector(nn.Module):
+    """Project a frozen DynaFLIP feature into the action-expert hidden width.
+
+    Zero-initialized (PVI, arXiv:2603.12772): at init the residual is exactly
+    zero, so the injected model is identical to the frozen base; the projection
+    is learned during fine-tuning.
+    """
+
+    def __init__(self, feature_dim: int, expert_width: int):
+        super().__init__()
+        self.proj = nn.Linear(feature_dim, expert_width)
+        nn.init.zeros_(self.proj.weight)
+        nn.init.zeros_(self.proj.bias)
+
+    def forward(self, feature: Tensor) -> Tensor:
+        # (B, feature_dim) -> (B, expert_width)
+        return self.proj(feature)
+
+
+class PI05DynaflipPytorch(PI05Pytorch):
+    """PI05 core model with a DynaFLIP PVI expert-residual injection seam."""
+
+    def __init__(self, config: PI05DynaflipConfig, rtc_processor=None):
+        super().__init__(config, rtc_processor=rtc_processor)
+        self._pending_dynaflip_feature = None
+        if config.inject_dynaflip:
+            expert_width = get_gemma_config(config.action_expert_variant).width
+            self.expert_injector = DynaflipExpertInjector(
+                config.dynaflip_feature_dim, expert_width
+            )
+        else:
+            self.expert_injector = None
+
+    def set_dynaflip_feature(self, feature: Tensor | None) -> None:
+        """Stash the precomputed feature for the next ``embed_suffix`` call."""
+        self._pending_dynaflip_feature = feature
+
+    def _inject_expert_aux(self, suffix_embs: Tensor) -> Tensor:
+        # Override of the base seam: add a zero-init residual built from the
+        # frozen DynaFLIP feature to every action-token hidden state. When the
+        # injector is absent or no feature is stashed, return embs unchanged,
+        # reproducing the base PI05 expert input exactly.
+        if self.expert_injector is None or self._pending_dynaflip_feature is None:
+            return suffix_embs
+        feat = self._pending_dynaflip_feature
+        if feat.dim() == 3:
+            # (B, T, dim) -> pool the transition window to a single feature.
+            feat = feat.mean(dim=1)
+        residual = self.expert_injector(feat.to(suffix_embs.dtype))  # (B, width)
+        return suffix_embs + residual[:, None, :]
+
+
+class PI05DynaflipPolicy(PI05Policy):
+    """PI05 policy that stashes the batch DynaFLIP feature for expert injection."""
+
+    config_class = PI05DynaflipConfig
+    name = "pi05_dynaflip"
+
+    def _build_model(self) -> PI05Pytorch:
+        return PI05DynaflipPytorch(self.config, rtc_processor=self.rtc_processor)
+
+    def forward(self, batch, reduction: str = "mean"):
+        self.model.set_dynaflip_feature(batch.get(self.config.dynaflip_feature_key))
+        return super().forward(batch, reduction=reduction)
+
+    @torch.no_grad()
+    def predict_action_chunk(self, batch, **kwargs):
+        self.model.set_dynaflip_feature(batch.get(self.config.dynaflip_feature_key))
+        return super().predict_action_chunk(batch, **kwargs)
