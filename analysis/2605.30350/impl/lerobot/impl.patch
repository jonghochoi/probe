+#!/usr/bin/env python
+
+# Copyright 2025 Physical Intelligence and The HuggingFace Inc. team. All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""PI0.5 + DynaFLIP frozen-injection variant — two injection modes.
+
+A frozen DynaFLIP encoder (arXiv:2605.30350) emits patch tokens that condition
+the action expert. They arrive precomputed in the batch under
+``config.dynaflip_feature_key`` (shape ``(B, L, dynaflip_feature_dim)``).
+
+``dynaflip_inject_mode``:
+
+* ``"copy_branch"`` — faithful PVI (arXiv:2603.12772). A zero-init projection
+  feeds a **trainable copy of the action expert** (init from the pretrained
+  expert) run over ``[aux ; action]``; its per-layer hidden (action positions)
+  is added into the frozen main expert via **zero-init per-layer residuals**
+  ``h_i += Z_i(h_i_copy)``.
+
+* ``"bridge_attention"`` — VLA-Adapter (arXiv:2509.09372) style. The action
+  tokens **cross-attend** to the projected DynaFLIP patch tokens; the residual
+  is scaled by ``tanh(g)`` with ``g`` zero-initialized (the CA1 "raw feature"
+  path of Bridge Attention). Lighter — no expert copy. DynaFLIP, a
+  dynamics-pretrained DINOv2, is exactly VLA-Adapter's action-aware "raw
+  feature" condition. ``g=0 -> tanh(g)=0 -> identity at init``, the same
+  zero-init principle as the copy-branch in cross-attention form.
+
+Frozen: SigLIP / VLM / LLM / main expert / aux encoder. Trained: the injection
+module only. Both modes are identity at init, so the policy equals base pi0.5
+until the visual signal is learned in.
+
+Two injection sites are wired because the base routes the expert differently
+per path: the **training** joint forward runs a manual per-layer loop (injected
+via the ``expert_layer_injector`` callback seam), while the **inference**
+``denoise_step`` runs the expert through HF's fused ``gemma_expert.model.forward``
+(injected via forward hooks on its layers). Each path triggers exactly one
+mechanism, so there is no double-injection. See impl.md §🚧 for the validation
+boundary — the weight-free smoke test covers structure / zero-init only; the
+copy-branch / cross-attention numerics over the full expert need the weighted
+runtime.
+
+All DynaFLIP *pretraining* (simplex alignment, TCN, actor losses, 3D-flow
+encoder) is out-of-base-scope.
+"""
+
+import copy
+
+import torch
+from torch import Tensor, nn
+
+from .configuration_pi05_dynaflip import PI05DynaflipConfig
+from .modeling_pi05 import (
+    PI05Policy,
+    PI05Pytorch,
+    get_gemma_config,
+    make_att_2d_masks,
+)
+
+
+def zero_init_linear(in_dim: int, out_dim: int) -> nn.Linear:
+    """A linear whose weight and bias are exactly zero (PVI zero-init): the
+    residual it produces is zero at init, so the injected policy is identical to
+    the frozen base until training learns the projection in."""
+    lin = nn.Linear(in_dim, out_dim)
+    nn.init.zeros_(lin.weight)
+    nn.init.zeros_(lin.bias)
+    return lin
+
+
+class DynaflipBridgeInjector(nn.Module):
+    """VLA-Adapter-style gated cross-attention injection (Bridge Attention CA1).
+
+    Per expert layer, the action tokens (query) cross-attend to the projected
+    DynaFLIP patch tokens (key/value); the attention output is scaled by a
+    learnable ``tanh(g)`` with ``g`` zero-initialized. At init ``tanh(0)=0`` so
+    the residual is exactly zero (identity), and the injection degree is
+    learned — the same zero-init principle as the PVI copy-branch.
+    """
+
+    def __init__(self, width: int, num_layers: int, num_heads: int, gate_per_layer: bool = True):
+        super().__init__()
+        self.num_layers = num_layers
+        self.gate_per_layer = gate_per_layer
+        self.attn = nn.ModuleList(
+            [nn.MultiheadAttention(width, num_heads, batch_first=True) for _ in range(num_layers)]
+        )
+        # g init 0 -> tanh(g) = 0 -> zero residual at init.
+        self.gate = nn.Parameter(torch.zeros(num_layers if gate_per_layer else 1))
+
+    def forward(self, layer_idx: int, query: Tensor, kv: Tensor) -> Tensor:
+        # query: (B, chunk, width) action tokens; kv: (B, L, width) dyna tokens.
+        attn_out, _ = self.attn[layer_idx](query, kv, kv, need_weights=False)
+        g = self.gate[layer_idx if self.gate_per_layer else 0]
+        return torch.tanh(g) * attn_out.to(query.dtype)
+
+
+class PI05DynaflipPytorch(PI05Pytorch):
+    """PI05 core model with a DynaFLIP injection (copy_branch or bridge_attention)."""
+
+    def __init__(self, config: PI05DynaflipConfig, rtc_processor=None):
+        super().__init__(config, rtc_processor=rtc_processor)
+        self._aux_tokens = None
+        self._mode = None
+        # copy_branch scratch
+        self._copy_hidden = None
+        self._copy_capture = None
+        self._copy_synced = False
+        # bridge_attention scratch
+        self._dyna_proj = None
+
+        if not config.inject_dynaflip:
+            self.aux_proj = None
+            self.copy_expert = None
+            self.inject_layers = None
+            self.bridge_injector = None
+            return
+
+        self._mode = config.dynaflip_inject_mode
+        pwe = self.paligemma_with_expert
+        expert_width = get_gemma_config(config.action_expert_variant).width
+        num_layers = pwe.gemma_expert.config.num_hidden_layers
+
+        if self._mode == "copy_branch":
+            # Zero-init projection feeds the copy-branch; identity at init.
+            self.aux_proj = zero_init_linear(config.dynaflip_feature_dim, expert_width)
+            self.copy_expert = copy.deepcopy(pwe.gemma_expert)
+            for p in self.copy_expert.parameters():
+                p.requires_grad = True
+            self.inject_layers = nn.ModuleList(
+                [zero_init_linear(expert_width, expert_width) for _ in range(num_layers)]
+            )
+            self.bridge_injector = None
+            self._register_copy_capture_hooks()
+        else:  # bridge_attention
+            # Normal projection (the gate provides the zero-init identity, so the
+            # KV should carry real dyna info rather than starting at zero).
+            self.aux_proj = nn.Linear(config.dynaflip_feature_dim, expert_width)
+            self.copy_expert = None
+            self.inject_layers = None
+            self.bridge_injector = DynaflipBridgeInjector(
+                expert_width, num_layers, config.dynaflip_num_heads, config.dynaflip_gate_per_layer
+            )
+
+        # Wire the training-path callback and the inference-path injection hooks
+        # (shared across both modes; the per-layer op dispatches on mode).
+        pwe.expert_layer_injector = self._inject_expert_layer
+        self._register_main_inject_hooks()
+
+    # -- public API ---------------------------------------------------------
+
+    def set_dynaflip_feature(self, feature: Tensor | None) -> None:
+        """Stash the precomputed aux patch tokens for the next forward."""
+        self._aux_tokens = feature
+        self._copy_hidden = None
+        self._dyna_proj = None
+
+    # -- internals ----------------------------------------------------------
+
+    def _injecting(self) -> bool:
+        return self._mode is not None and self._aux_tokens is not None
+
+    def _aux_as_tokens(self) -> Tensor:
+        aux = self._aux_tokens
+        if aux.dim() == 2:
+            aux = aux[:, None, :]  # (B, dim) -> (B, 1, dim)
+        return aux
+
+    # ---- hooks -------------------------------------------------------------
+
+    def _register_copy_capture_hooks(self) -> None:
+        for i, layer in enumerate(self.copy_expert.model.layers):
+            layer.register_forward_hook(self._make_capture_hook(i))
+
+    def _register_main_inject_hooks(self) -> None:
+        # Fire only in the fused inference path (denoise_step); the training
+        # joint loop uses the expert_layer_injector callback instead.
+        main_layers = self.paligemma_with_expert.gemma_expert.model.layers
+        for i, layer in enumerate(main_layers):
+            layer.register_forward_hook(self._make_inject_hook(i))
+
+    def _make_capture_hook(self, i: int):
+        def hook(_module, _inp, out):
+            if self._copy_capture is not None:
+                self._copy_capture[i] = out[0] if isinstance(out, tuple) else out
+
+        return hook
+
+    def _make_inject_hook(self, i: int):
+        def hook(_module, _inp, out):
+            residual = self._layer_residual(i, out[0] if isinstance(out, tuple) else out)
+            if residual is None:
+                return out
+            h = out[0] if isinstance(out, tuple) else out
+            chunk = residual.shape[1]
+            h = h.clone()
+            h[:, -chunk:] = h[:, -chunk:] + residual
+            return (h, *out[1:]) if isinstance(out, tuple) else h
+
+        return hook
+
+    # ---- per-layer residual (mode dispatch, shared by both paths) ----------
+
+    def _layer_residual(self, layer_idx: int, layer_hidden: Tensor) -> Tensor | None:
+        """Return the residual to add at expert layer ``layer_idx`` (action
+        positions), or None when not injecting. ``layer_hidden`` is the action
+        stream so cross-attention can use it as the query."""
+        if self._mode == "copy_branch":
+            if self._copy_hidden is None or self._copy_hidden[layer_idx] is None:
+                return None
+            ch = self._copy_hidden[layer_idx]
+            return self.inject_layers[layer_idx](ch).to(layer_hidden.dtype)
+        if self._mode == "bridge_attention":
+            if self._dyna_proj is None:
+                return None
+            chunk = layer_hidden.shape[1]
+            query = layer_hidden[:, -chunk:]
+            return self.bridge_injector(layer_idx, query, self._dyna_proj)
+        return None
+
+    def _inject_expert_layer(self, layer_idx: int, suffix_hidden: Tensor) -> Tensor:
+        # Training-path per-layer injection (manual joint loop). suffix_hidden is
+        # the expert stream, sequence == chunk (action tokens).
+        residual = self._layer_residual(layer_idx, suffix_hidden)
+        if residual is None:
+            return suffix_hidden
+        return suffix_hidden + residual
+
+    # ---- copy_branch: compute per-layer copy hidden ------------------------
+
+    def _maybe_sync_copy(self) -> None:
+        # Initialize the copy-branch from the (now loaded) pretrained expert.
+        if self.copy_expert is not None and not self._copy_synced:
+            self.copy_expert.load_state_dict(
+                self.paligemma_with_expert.gemma_expert.state_dict()
+            )
+            self._copy_synced = True
+
+    def _compute_copy_hidden(self, suffix_embs: Tensor, adarms_cond: Tensor) -> None:
+        self._maybe_sync_copy()
+        aux_emb = self.aux_proj(self._aux_as_tokens().to(suffix_embs.dtype))  # (B, L, width)
+
+        full = torch.cat([aux_emb, suffix_embs], dim=1)
+        bsize, total_len, _ = full.shape
+        aux_len = aux_emb.shape[1]
+        chunk = suffix_embs.shape[1]
+
+        pad = torch.ones(bsize, total_len, dtype=torch.bool, device=full.device)
+        # aux tokens form a bidirectional prefix; the action block starts at aux_len.
+        att = torch.zeros(total_len, dtype=full.dtype, device=full.device)
+        att[aux_len] = 1
+        att = att[None, :].expand(bsize, total_len)
+        att_2d = make_att_2d_masks(pad, att)
+        att_4d = self._prepare_attention_masks_4d(att_2d)
+        position_ids = torch.cumsum(pad, dim=1) - 1
+
+        self._copy_capture = [None] * len(self.inject_layers)
+        self.copy_expert.model.forward(
+            inputs_embeds=full,
+            attention_mask=att_4d,
+            position_ids=position_ids,
+            past_key_values=None,
+            use_cache=False,
+            adarms_cond=adarms_cond,
+        )
+        # Keep only the action positions of each captured layer hidden.
+        self._copy_hidden = [
+            h[:, -chunk:] if h is not None else None for h in self._copy_capture
+        ]
+
+    # ---- shared entry: prepare conditions in embed_suffix ------------------
+
+    def embed_suffix(self, noisy_actions, timestep):
+        embs, pad_masks, att_masks, adarms_cond = super().embed_suffix(noisy_actions, timestep)
+        if self._injecting():
+            if self._mode == "copy_branch":
+                self._compute_copy_hidden(embs, adarms_cond)
+            else:  # bridge_attention: project + stash dyna tokens (no copy forward)
+                self._dyna_proj = self.aux_proj(self._aux_as_tokens().to(embs.dtype))
+        return embs, pad_masks, att_masks, adarms_cond
+
+
+class PI05DynaflipPolicy(PI05Policy):
+    """PI05 policy that feeds the batch DynaFLIP tokens to the injection module."""
+
+    config_class = PI05DynaflipConfig
+    name = "pi05_dynaflip"
+
+    def _build_model(self) -> PI05Pytorch:
+        return PI05DynaflipPytorch(self.config, rtc_processor=self.rtc_processor)
+
+    def forward(self, batch, reduction: str = "mean"):
+        self.model.set_dynaflip_feature(batch.get(self.config.dynaflip_feature_key))
+        return super().forward(batch, reduction=reduction)
+
+    @torch.no_grad()
+    def predict_action_chunk(self, batch, **kwargs):
+        self.model.set_dynaflip_feature(batch.get(self.config.dynaflip_feature_key))
+        return super().predict_action_chunk(batch, **kwargs)
