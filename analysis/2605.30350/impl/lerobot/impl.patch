+from dataclasses import dataclass
+
+from lerobot.configs import PreTrainedConfig
+
+from .configuration_pi05 import PI05Config
+
+
+@PreTrainedConfig.register_subclass("pi05_dynaflip")
+@dataclass
+class PI05DynaflipConfig(PI05Config):
+    """PI0.5 + DynaFLIP frozen-injection variant (two injection modes).
+
+    A frozen auxiliary visual encoder (DynaFLIP, arXiv:2605.30350) emits
+    patch-token sequences that are injected into the action expert's hidden
+    space. Two ``dynaflip_inject_mode`` options:
+
+    * ``"copy_branch"`` (default) — faithful PVI (arXiv:2603.12772): a
+      zero-init projection feeds a **trainable copy of the action expert**
+      (init from the pretrained expert) whose per-layer hidden is added as a
+      **zero-init per-layer residual** into the frozen main expert.
+    * ``"bridge_attention"`` — VLA-Adapter (arXiv:2509.09372) style: the action
+      tokens **cross-attend** to the projected DynaFLIP patch tokens, gated by
+      a learnable ``tanh(g)`` with ``g`` zero-initialized (the "raw feature"
+      CA1 path of Bridge Attention). Lighter — no expert copy. DynaFLIP, being
+      a dynamics-pretrained DINOv2, is exactly VLA-Adapter's action-aware
+      "raw feature" condition.
+
+    Frozen: SigLIP / VLM / LLM / main action expert / aux encoder. Trained:
+    the injection module only. Both modes are **zero-init -> identity at init**,
+    so the policy equals base pi0.5 until the visual signal is learned in.
+    Defaults reproduce vanilla PI05 (``inject_dynaflip=False``).
+    """
+
+    # Master switch. False -> identical to PI05.
+    inject_dynaflip: bool = False
+    # Injection mechanism: "copy_branch" (PVI) | "bridge_attention" (VLA-Adapter).
+    dynaflip_inject_mode: str = "copy_branch"
+    # Per-token feature dim of the auxiliary DynaFLIP patch tokens.
+    # DINOv2-Base patch-token width = 768. See analysis/2605.30350/design.md.
+    dynaflip_feature_dim: int = 768
+    # Batch key carrying the precomputed frozen DynaFLIP patch tokens,
+    # shape (B, L, dynaflip_feature_dim) with L = views * patches.
+    dynaflip_feature_key: str = "observation.dynaflip_feature"
+
+    # --- bridge_attention mode only ---
+    # Cross-attention heads for the Bridge injector.
+    dynaflip_num_heads: int = 8
+    # One learnable tanh gate per expert layer (vs a single shared gate).
+    dynaflip_gate_per_layer: bool = True
+    # Optional VLA-Adapter CA2 (ActionQuery + proprio). Reserved; not yet wired.
+    dynaflip_use_action_query: bool = False
+    dynaflip_action_query_tokens: int = 64
+
+    def __post_init__(self):
+        super().__post_init__()
+        if self.dynaflip_feature_dim <= 0:
+            raise ValueError(
+                f"dynaflip_feature_dim must be positive, got {self.dynaflip_feature_dim}"
+            )
+        valid_modes = ("copy_branch", "bridge_attention")
+        if self.dynaflip_inject_mode not in valid_modes:
+            raise ValueError(
+                f"dynaflip_inject_mode must be one of {valid_modes}, "
+                f"got {self.dynaflip_inject_mode!r}"
+            )
+        if self.dynaflip_num_heads <= 0:
+            raise ValueError(
+                f"dynaflip_num_heads must be positive, got {self.dynaflip_num_heads}"
+            )
+        if self.dynaflip_use_action_query:
+            raise NotImplementedError(
+                "dynaflip_use_action_query (VLA-Adapter CA2) is reserved but not "
+                "yet implemented; leave it False for the bridge_attention first cut."
+            )
