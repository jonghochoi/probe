+#!/usr/bin/env python
+
+# Copyright 2025 Physical Intelligence and The HuggingFace Inc. team. All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""PI0.5 + DynaFLIP frozen-injection (PVI) variant — faithful copy-branch.
+
+Maps DynaFLIP's VLA integration (arXiv:2605.30350 §3.4 / appendix) onto the
+lerobot pi05 base, following plug-in visual injection (PVI, arXiv:2603.12772):
+
+  * **Auxiliary encoder** — DynaFLIP (frozen) emits patch-token sequences; here
+    they arrive precomputed in the batch under ``config.dynaflip_feature_key``,
+    shape ``(B, L, dynaflip_feature_dim)``.
+  * **Projection** — a zero-initialized linear maps aux tokens to the action
+    expert hidden width.
+  * **Copy-branch** — a trainable copy of the action expert (``gemma_expert``),
+    initialized from the pretrained expert, runs over ``[aux_tokens ; action
+    tokens]`` so the action positions attend to the aux context; its per-layer
+    hidden states (at the action positions) are captured.
+  * **Per-layer injectors** — one zero-initialized linear per expert layer adds
+    the copy-branch hidden as a residual into the frozen main expert at every
+    layer: ``h_i_main += Z_i(h_i_copy)`` (PVI Eq. for the residual pathway).
+
+Frozen: SigLIP / VLM / LLM / main expert / aux encoder. Trained: projection +
+copy-branch + per-layer injectors. The zero-init projection & injectors make
+the policy identical to base pi0.5 at init; the visual signal is learned in.
+
+Two injection sites are needed because the base routes the expert differently
+per path: the **training** joint forward runs a manual per-layer loop (injected
+via the ``expert_layer_injector`` callback seam), while the **inference**
+``denoise_step`` runs the expert through HF's fused ``gemma_expert.model.forward``
+(injected via forward hooks on its layers). Each path triggers exactly one
+mechanism, so there is no double-injection. See impl.md §🚧 for the validation
+boundary — the weight-free smoke test covers structure / zero-init only; the
+copy-branch forward (attention, masks) needs the weighted runtime.
+
+All DynaFLIP *pretraining* (simplex alignment, TCN, actor losses, 3D-flow
+encoder) is out-of-base-scope.
+"""
+
+import copy
+
+import torch
+from torch import Tensor, nn
+
+from .configuration_pi05_dynaflip import PI05DynaflipConfig
+from .modeling_pi05 import (
+    PI05Policy,
+    PI05Pytorch,
+    get_gemma_config,
+    make_att_2d_masks,
+)
+
+
+def zero_init_linear(in_dim: int, out_dim: int) -> nn.Linear:
+    """A linear whose weight and bias are exactly zero (PVI zero-init): the
+    residual it produces is zero at init, so the injected policy is identical to
+    the frozen base until training learns the projection in."""
+    lin = nn.Linear(in_dim, out_dim)
+    nn.init.zeros_(lin.weight)
+    nn.init.zeros_(lin.bias)
+    return lin
+
+
+class PI05DynaflipPytorch(PI05Pytorch):
+    """PI05 core model with a faithful DynaFLIP PVI copy-branch."""
+
+    def __init__(self, config: PI05DynaflipConfig, rtc_processor=None):
+        super().__init__(config, rtc_processor=rtc_processor)
+        self._aux_tokens = None
+        self._copy_hidden = None  # per main-layer copy hidden (action positions)
+        self._copy_capture = None  # scratch filled by copy-branch capture hooks
+        self._copy_synced = False
+
+        if config.inject_dynaflip:
+            pwe = self.paligemma_with_expert
+            expert_width = get_gemma_config(config.action_expert_variant).width
+            num_layers = pwe.gemma_expert.config.num_hidden_layers
+
+            # Zero-init projection: aux patch tokens -> expert hidden width.
+            self.aux_proj = zero_init_linear(config.dynaflip_feature_dim, expert_width)
+
+            # Trainable copy of the action expert (synced from the pretrained
+            # expert lazily on first forward, once weights are loaded).
+            self.copy_expert = copy.deepcopy(pwe.gemma_expert)
+            for p in self.copy_expert.parameters():
+                p.requires_grad = True
+
+            # Zero-init per-layer injectors Z_i.
+            self.inject_layers = nn.ModuleList(
+                [zero_init_linear(expert_width, expert_width) for _ in range(num_layers)]
+            )
+
+            # Wire the training-path callback and the inference-path hooks.
+            pwe.expert_layer_injector = self._inject_expert_layer
+            self._register_hooks()
+        else:
+            self.aux_proj = None
+            self.copy_expert = None
+            self.inject_layers = None
+
+    # -- public API ---------------------------------------------------------
+
+    def set_dynaflip_feature(self, feature: Tensor | None) -> None:
+        """Stash the precomputed aux patch tokens for the next forward."""
+        self._aux_tokens = feature
+        self._copy_hidden = None
+
+    # -- internals ----------------------------------------------------------
+
+    def _injecting(self) -> bool:
+        return self.copy_expert is not None and self._aux_tokens is not None
+
+    def _maybe_sync_copy(self) -> None:
+        # Initialize the copy-branch from the (now loaded) pretrained expert.
+        if self.copy_expert is not None and not self._copy_synced:
+            self.copy_expert.load_state_dict(
+                self.paligemma_with_expert.gemma_expert.state_dict()
+            )
+            self._copy_synced = True
+
+    def _register_hooks(self) -> None:
+        # Capture per-layer hidden of the copy-branch.
+        for i, layer in enumerate(self.copy_expert.model.layers):
+            layer.register_forward_hook(self._make_capture_hook(i))
+        # Inject into the main expert (fires only in the fused inference path).
+        main_layers = self.paligemma_with_expert.gemma_expert.model.layers
+        for i, layer in enumerate(main_layers):
+            layer.register_forward_hook(self._make_inject_hook(i))
+
+    def _make_capture_hook(self, i: int):
+        def hook(_module, _inp, out):
+            if self._copy_capture is not None:
+                self._copy_capture[i] = out[0] if isinstance(out, tuple) else out
+
+        return hook
+
+    def _make_inject_hook(self, i: int):
+        def hook(_module, _inp, out):
+            if self._copy_hidden is None or self._copy_hidden[i] is None:
+                return out
+            h = out[0] if isinstance(out, tuple) else out
+            ch = self._copy_hidden[i]
+            add = self.inject_layers[i](ch).to(h.dtype)
+            chunk = ch.shape[1]
+            h = h.clone()
+            h[:, -chunk:] = h[:, -chunk:] + add
+            return (h, *out[1:]) if isinstance(out, tuple) else h
+
+        return hook
+
+    def _inject_expert_layer(self, layer_idx: int, suffix_hidden: Tensor) -> Tensor:
+        # Training-path per-layer residual (manual joint loop). suffix_hidden is
+        # the expert stream, sequence == chunk (action tokens).
+        if self._copy_hidden is None or self._copy_hidden[layer_idx] is None:
+            return suffix_hidden
+        ch = self._copy_hidden[layer_idx]
+        add = self.inject_layers[layer_idx](ch).to(suffix_hidden.dtype)
+        return suffix_hidden + add
+
+    def _compute_copy_hidden(self, suffix_embs: Tensor, adarms_cond: Tensor) -> None:
+        self._maybe_sync_copy()
+        aux = self._aux_tokens
+        if aux.dim() == 2:
+            aux = aux[:, None, :]  # (B, dim) -> (B, 1, dim)
+        aux_emb = self.aux_proj(aux.to(suffix_embs.dtype))  # (B, L, width)
+
+        full = torch.cat([aux_emb, suffix_embs], dim=1)
+        bsize, total_len, _ = full.shape
+        aux_len = aux_emb.shape[1]
+        chunk = suffix_embs.shape[1]
+
+        pad = torch.ones(bsize, total_len, dtype=torch.bool, device=full.device)
+        # aux tokens form a bidirectional prefix; the action block starts at aux_len.
+        att = torch.zeros(total_len, dtype=full.dtype, device=full.device)
+        att[aux_len] = 1
+        att = att[None, :].expand(bsize, total_len)
+        att_2d = make_att_2d_masks(pad, att)
+        att_4d = self._prepare_attention_masks_4d(att_2d)
+        position_ids = torch.cumsum(pad, dim=1) - 1
+
+        self._copy_capture = [None] * len(self.inject_layers)
+        self.copy_expert.model.forward(
+            inputs_embeds=full,
+            attention_mask=att_4d,
+            position_ids=position_ids,
+            past_key_values=None,
+            use_cache=False,
+            adarms_cond=adarms_cond,
+        )
+        # Keep only the action positions of each captured layer hidden.
+        self._copy_hidden = [
+            h[:, -chunk:] if h is not None else None for h in self._copy_capture
+        ]
+
+    def embed_suffix(self, noisy_actions, timestep):
+        embs, pad_masks, att_masks, adarms_cond = super().embed_suffix(noisy_actions, timestep)
+        if self._injecting():
+            self._compute_copy_hidden(embs, adarms_cond)
+        return embs, pad_masks, att_masks, adarms_cond
+
+
+class PI05DynaflipPolicy(PI05Policy):
+    """PI05 policy that feeds the batch DynaFLIP tokens to the copy-branch."""
+
+    config_class = PI05DynaflipConfig
+    name = "pi05_dynaflip"
+
+    def _build_model(self) -> PI05Pytorch:
+        return PI05DynaflipPytorch(self.config, rtc_processor=self.rtc_processor)
+
+    def forward(self, batch, reduction: str = "mean"):
+        self.model.set_dynaflip_feature(batch.get(self.config.dynaflip_feature_key))
+        return super().forward(batch, reduction=reduction)
+
+    @torch.no_grad()
+    def predict_action_chunk(self, batch, **kwargs):
+        self.model.set_dynaflip_feature(batch.get(self.config.dynaflip_feature_key))
+        return super().predict_action_chunk(batch, **kwargs)
