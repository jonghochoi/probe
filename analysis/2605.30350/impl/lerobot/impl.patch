@@ -0,0 +1,100 @@
+#!/usr/bin/env python
+
+# Copyright 2025 Physical Intelligence and The HuggingFace Inc. team. All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""PI0.5 + DynaFLIP frozen-injection (PVI) variant.
+
+Maps the downstream integration of DynaFLIP (arXiv:2605.30350 §3.4, Plug-in
+Visual Injection) onto the lerobot pi05 base. A frozen auxiliary visual feature
+is projected to the PaliGemma hidden width and appended as extra prefix tokens,
+leaving the SigLIP encoder / VLM / LLM untouched (prior-preserving). All
+DynaFLIP *pretraining* (simplex alignment, TCN, actor losses, 3D-flow encoder)
+is out-of-base-scope: the feature arrives precomputed in the batch.
+"""
+
+import torch
+from torch import Tensor, nn
+
+from .configuration_pi05_dynaflip import PI05DynaflipConfig
+from .modeling_pi05 import PI05Policy, PI05Pytorch, get_gemma_config
+
+
+class DynaflipPrefixInjector(nn.Module):
+    """Project a frozen DynaFLIP feature into ``num_tokens`` prefix tokens."""
+
+    def __init__(self, feature_dim: int, hidden_dim: int, num_tokens: int):
+        super().__init__()
+        self.hidden_dim = hidden_dim
+        self.num_tokens = num_tokens
+        self.proj = nn.Linear(feature_dim, hidden_dim * num_tokens)
+
+    def forward(self, feature: Tensor) -> Tensor:
+        # (B, feature_dim) -> (B, num_tokens, hidden_dim)
+        bsize = feature.shape[0]
+        return self.proj(feature).view(bsize, self.num_tokens, self.hidden_dim)
+
+
+class PI05DynaflipPytorch(PI05Pytorch):
+    """PI05 core model with a DynaFLIP PVI prefix-injection seam."""
+
+    def __init__(self, config: PI05DynaflipConfig, rtc_processor=None):
+        super().__init__(config, rtc_processor=rtc_processor)
+        self._pending_dynaflip_feature = None
+        if config.inject_dynaflip:
+            hidden_dim = get_gemma_config(config.paligemma_variant).width
+            self.injector = DynaflipPrefixInjector(
+                config.dynaflip_feature_dim, hidden_dim, config.dynaflip_num_tokens
+            )
+        else:
+            self.injector = None
+
+    def set_dynaflip_feature(self, feature: Tensor | None) -> None:
+        """Stash the precomputed feature for the next ``embed_prefix`` call."""
+        self._pending_dynaflip_feature = feature
+
+    def _extra_prefix_embeds(self):
+        # Override of the base seam: append projected DynaFLIP tokens when the
+        # injector is built and a feature has been stashed. Otherwise None, which
+        # reproduces the base PI05 prefix exactly.
+        if self.injector is None or self._pending_dynaflip_feature is None:
+            return None
+        feat = self._pending_dynaflip_feature
+        if feat.dim() == 3:
+            # (B, T, dim) -> pool the transition window to a single feature.
+            feat = feat.mean(dim=1)
+        proj = self.injector(feat.to(self.injector.proj.weight.dtype))
+        mask = torch.ones(
+            proj.shape[0], proj.shape[1], dtype=torch.bool, device=proj.device
+        )
+        return proj, mask
+
+
+class PI05DynaflipPolicy(PI05Policy):
+    """PI05 policy that stashes the batch DynaFLIP feature for prefix injection."""
+
+    config_class = PI05DynaflipConfig
+    name = "pi05_dynaflip"
+
+    def _build_model(self) -> PI05Pytorch:
+        return PI05DynaflipPytorch(self.config, rtc_processor=self.rtc_processor)
+
+    def forward(self, batch, reduction: str = "mean"):
+        self.model.set_dynaflip_feature(batch.get(self.config.dynaflip_feature_key))
+        return super().forward(batch, reduction=reduction)
+
+    @torch.no_grad()
+    def predict_action_chunk(self, batch, **kwargs):
+        self.model.set_dynaflip_feature(batch.get(self.config.dynaflip_feature_key))
+        return super().predict_action_chunk(batch, **kwargs)
