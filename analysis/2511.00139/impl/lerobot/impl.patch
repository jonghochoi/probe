+"""Config for the Arm-Hand Feature Enhancement extension of pi0.
+
+Reproduction of arXiv:2511.00139 §7.3 / Eq. (9)-(12) (Design §🧰, §📊): the
+action expert's final hidden state (``z_share``) is branched into per-limb
+arm/hand sub-pathways with index-masked auxiliary flow-matching losses, plus a
+fused-concat main head. ``feature_enhancement=False`` makes the policy behave
+exactly like vanilla pi0 (the πuni-origin baseline), so origin-vs-enhance is a
+single config flag with no training-script changes.
+"""
+
+from dataclasses import dataclass
+
+from lerobot.configs import PreTrainedConfig
+
+from .configuration_pi0 import PI0Config
+
+
+@PreTrainedConfig.register_subclass("pi0_enhance")
+@dataclass
+class PI0EnhanceConfig(PI0Config):
+    # Toggle: False -> vanilla pi0 (πuni-origin); True -> feature enhancement (πuni-enhance).
+    feature_enhancement: bool = False
+
+    # Index split of the (padded) action vector for selective supervision
+    # (paper §7.3 / Design 데이터 계약): arm = [0, arm_dim);
+    # hand = [arm_dim, original_action_dim). Default 6 = UR3e 6-DoF arm; the
+    # paper's hand is 12-DoF, so original_action_dim is 18 on that contract.
+    arm_dim: int = 6
+
+    # Auxiliary loss weight lambda: L_total = L_main + lambda * (L_arm + L_hand)
+    # (Eq. (12)).
+    # NOTE: paper §3.4.2 silent on lambda's value; default 1.0 chosen — reason:
+    # equal weight on aux vs main, a common SFT default. Sweep when reproducing.
+    aux_loss_weight: float = 1.0
+
+    def __post_init__(self):
+        super().__post_init__()
+        if self.arm_dim < 0 or self.arm_dim > self.max_action_dim:
+            raise ValueError(
+                f"arm_dim ({self.arm_dim}) must be in [0, max_action_dim={self.max_action_dim}]"
+            )
+        if self.aux_loss_weight < 0:
+            raise ValueError(f"aux_loss_weight ({self.aux_loss_weight}) must be non-negative")
