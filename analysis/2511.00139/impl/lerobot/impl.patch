+#!/usr/bin/env python
+
+# Copyright 2025 Physical Intelligence and The HuggingFace Inc. team. All rights reserved.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+"""Arm-Hand Feature Enhancement — reproduction of arXiv:2511.00139 §7.3.
+
+The action expert's final hidden state (``z_share``, the hook point extracted
+into ``PI0Pytorch._compute_suffix_out``) is branched into arm/hand sub-pathways
+with index-masked auxiliary flow-matching losses, plus a main head over the
+concatenated features (Design §🧰, Eq. (9)-(12)):
+
+    z_arm  = E_arm(z_share)                      # 2-layer MLP, Mish
+    z_hand = E_hand(z_share)
+    v_arm  = H_arm(z_arm)                         # index-masked aux loss (arm)
+    v_hand = H_hand(z_hand)                       # index-masked aux loss (hand)
+    v_main = H_main([z_share; z_arm; z_hand])     # main flow loss   (Eq. (9))
+    L = L_main + lambda * (L_arm + L_hand)        #                  (Eq. (12))
+
+``H_main`` is also the inference head, swapped in via the
+``_project_to_action`` seam on the base class — training and inference share
+the same projection so that the action produced at rollout matches the head
+the loss optimised.
+
+For fair train-loss comparison against vanilla pi0, ``forward`` stashes the
+main-only squared error on ``self._last_se_main`` (detached); the policy-level
+``forward`` reads it and logs ``loss_main`` / ``loss_main_per_dim`` alongside
+the composite ``loss``. Without this, the composite (main + aux) is not
+directly comparable to base pi0's main-only loss.
+
+``feature_enhancement=False`` defers entirely to vanilla pi0 (πuni-origin).
+"""
+
+import torch
+from torch import Tensor, nn
+
+from lerobot.utils.constants import ACTION
+
+from .configuration_pi0_enhance import PI0EnhanceConfig
+from .modeling_pi0 import PI0Policy, PI0Pytorch, get_gemma_config
+
+
+def build_index_masks(arm_dim: int, original_action_dim: int, max_action_dim: int) -> tuple[Tensor, Tensor]:
+    """Build disjoint arm/hand supervision masks over the padded action vector.
+
+    arm  = indices [0, arm_dim)
+    hand = indices [arm_dim, original_action_dim)
+    padding indices [original_action_dim, max_action_dim) are zero in both.
+    """
+    idx = torch.arange(max_action_dim)  # (max_action_dim,)
+    arm_mask = ((idx < arm_dim) & (idx < original_action_dim)).to(torch.float32)
+    hand_mask = ((idx >= arm_dim) & (idx < original_action_dim)).to(torch.float32)
+    return arm_mask, hand_mask
+
+
+def compute_feature_enhancement_loss(
+    v_main: Tensor,
+    v_arm: Tensor,
+    v_hand: Tensor,
+    u_t: Tensor,
+    arm_mask: Tensor,
+    hand_mask: Tensor,
+    aux_loss_weight: float,
+) -> Tensor:
+    """Composite flow-matching loss, returned per-dim as ``(B, T, A)``.
+
+    Mirrors ``F.mse_loss(reduction="none")`` for the main term (Eq. (9)) so the
+    result plugs into ``PI0Policy.forward`` unchanged. Auxiliary terms (Eq. (10)
+    -(11)) are squared error gated by the (1, 1, A) index masks (paper §7.3
+    selective supervision).
+    """
+    arm_mask = arm_mask.to(device=u_t.device, dtype=u_t.dtype).view(1, 1, -1)  # (1,1,A)
+    hand_mask = hand_mask.to(device=u_t.device, dtype=u_t.dtype).view(1, 1, -1)  # (1,1,A)
+
+    se_main = (v_main - u_t) ** 2  # (B,T,A)
+    se_arm = ((v_arm - u_t) ** 2) * arm_mask  # (B,T,A)
+    se_hand = ((v_hand - u_t) ** 2) * hand_mask  # (B,T,A)
+
+    return se_main + aux_loss_weight * (se_arm + se_hand)  # (B,T,A)  — Eq. (12)
+
+
+class ArmHandFeatureEnhancer(nn.Module):
+    """Branches z_share into arm/hand sub-pathways + a fused-concat main head.
+
+    E_arm/E_hand: 2-layer MLP with Mish, R^d_s -> R^{d_s/2} (paper §7.3).
+    H_arm/H_hand/H_main: single Linear to ``max_action_dim``.
+    """
+
+    def __init__(self, d_s: int, max_action_dim: int):
+        super().__init__()
+        d_half = d_s // 2
+
+        self.E_arm = nn.Sequential(nn.Linear(d_s, d_s), nn.Mish(), nn.Linear(d_s, d_half))  # R^d_s -> R^{d_s/2}
+        self.E_hand = nn.Sequential(nn.Linear(d_s, d_s), nn.Mish(), nn.Linear(d_s, d_half))  # R^d_s -> R^{d_s/2}
+
+        self.H_arm = nn.Linear(d_half, max_action_dim)  # R^{d_s/2} -> R^A
+        self.H_hand = nn.Linear(d_half, max_action_dim)  # R^{d_s/2} -> R^A
+        self.H_main = nn.Linear(d_s + 2 * d_half, max_action_dim)  # [z_share; z_arm; z_hand] -> R^A
+
+    def forward(self, z_share: Tensor) -> tuple[Tensor, Tensor, Tensor]:
+        z_share = z_share.to(torch.float32)  # (B, T, d_s)
+        z_arm = self.E_arm(z_share)  # (B, T, d_s/2)
+        z_hand = self.E_hand(z_share)  # (B, T, d_s/2)
+
+        v_arm = self.H_arm(z_arm)  # (B, T, A)
+        v_hand = self.H_hand(z_hand)  # (B, T, A)
+        v_main = self.H_main(torch.cat([z_share, z_arm, z_hand], dim=-1))  # (B, T, A)
+        return v_main, v_arm, v_hand
+
+
+class PI0EnhancePytorch(PI0Pytorch):
+    """pi0 core model with the optional arm-hand feature enhancement head."""
+
+    def __init__(self, config: PI0EnhanceConfig, rtc_processor=None):
+        super().__init__(config, rtc_processor=rtc_processor)
+        self.config: PI0EnhanceConfig = config
+
+        if not config.feature_enhancement:
+            return  # πuni-origin: behave exactly like vanilla pi0
+
+        d_s = get_gemma_config(config.action_expert_variant).width
+        self.feature_enhancer = ArmHandFeatureEnhancer(d_s, config.max_action_dim)
+
+        try:
+            original_action_dim = config.output_features[ACTION].shape[0]
+        except (KeyError, AttributeError, TypeError):
+            original_action_dim = config.max_action_dim
+        arm_mask, hand_mask = build_index_masks(config.arm_dim, original_action_dim, config.max_action_dim)
+        self.register_buffer("arm_mask", arm_mask, persistent=False)  # (A,)
+        self.register_buffer("hand_mask", hand_mask, persistent=False)  # (A,)
+
+    def _project_to_action(self, suffix_out: Tensor) -> Tensor:
+        """Use ``H_main`` as the action head when feature enhancement is on so
+        training and inference share the same projection."""
+        if not self.config.feature_enhancement:
+            return super()._project_to_action(suffix_out)
+        v_main, _, _ = self.feature_enhancer(suffix_out)
+        return v_main
+
+    def forward(self, images, img_masks, lang_tokens, lang_masks, state, actions, noise, time) -> Tensor:
+        if not self.config.feature_enhancement:
+            return super().forward(images, img_masks, lang_tokens, lang_masks, state, actions, noise, time)
+
+        suffix_out, u_t = self._compute_suffix_out(
+            images, img_masks, lang_tokens, lang_masks, state, actions, noise, time
+        )  # suffix_out (B,T,d_s) float32; u_t (B,T,A)
+
+        v_main, v_arm, v_hand = self._apply_checkpoint(self.feature_enhancer, suffix_out)
+        # Stash main-only squared error (detached) so the policy-level
+        # `forward` can log loss_main / loss_main_per_dim next to the
+        # composite loss. base's `loss` mixes aux terms and is not directly
+        # comparable to vanilla pi0's main-only `loss`; `loss_main` is.
+        self._last_se_main = ((v_main - u_t) ** 2).detach()
+        return compute_feature_enhancement_loss(
+            v_main, v_arm, v_hand, u_t, self.arm_mask, self.hand_mask, self.config.aux_loss_weight
+        )  # (B,T,A) — same contract as base PI0Pytorch.forward
+
+
+class PI0EnhancePolicy(PI0Policy):
+    """pi0 policy variant exposing the arm-hand feature-enhancement reproduction.
+
+    Reuses pi0 processors (selected via ``isinstance(cfg, PI0Config)`` in the
+    policy factory). ``_project_to_action`` on the model routes inference
+    through ``H_main``, and ``forward`` below adds main-only metrics to the
+    loss dict for fair comparison against vanilla pi0.
+    """
+
+    config_class = PI0EnhanceConfig
+    name = "pi0_enhance"
+
+    def _build_model(self, config: PI0EnhanceConfig) -> PI0EnhancePytorch:
+        return PI0EnhancePytorch(config, rtc_processor=self.rtc_processor)
+
+    def forward(self, batch: dict[str, Tensor], reduction: str = "mean") -> tuple[Tensor, dict]:
+        loss, loss_dict = super().forward(batch, reduction)
+        if not getattr(self.config, "feature_enhancement", False):
+            return loss, loss_dict
+        se_main = getattr(self.model, "_last_se_main", None)
+        if se_main is not None:
+            original_action_dim = self.config.output_features[ACTION].shape[0]
+            se_main = se_main[:, :, :original_action_dim]
+            loss_dict["loss_main_per_dim"] = se_main.mean(dim=[0, 1]).cpu().numpy().tolist()
+            loss_dict["loss_main"] = se_main.mean().item()
+        return loss, loss_dict
