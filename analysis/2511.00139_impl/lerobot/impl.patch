+class ArmHandFeatureEnhancement(nn.Module):
+    """Arm-Hand Feature Enhancement (arXiv:2511.00139, §7.3).
+
+    Splits the π0 expert's shared latent ``z_share`` (per-chunk, width=W)
+    into per-limb latents ``z_arm``, ``z_hand`` (width=W/2) via two
+    2-layer MLPs with Mish activation, attaches single-linear auxiliary
+    heads for selective DoF supervision, and produces a fused latent
+    ``concat([z_share, z_arm, z_hand])`` projected back to width W so the
+    existing π0 ``action_out_proj`` flow-matching head can consume it
+    without further changes.
+    """
+
+    def __init__(self, width: int, max_action_dim: int):
+        super().__init__()
+        half = width // 2
+        self.half = half
+        self.arm_mlp = nn.Sequential(
+            nn.Linear(width, width),
+            nn.Mish(),
+            nn.Linear(width, half),
+            nn.Mish(),
+        )
+        self.hand_mlp = nn.Sequential(
+            nn.Linear(width, width),
+            nn.Mish(),
+            nn.Linear(width, half),
+            nn.Mish(),
+        )
+        self.aux_arm = nn.Linear(half, max_action_dim)
+        self.aux_hand = nn.Linear(half, max_action_dim)
+        self.main_proj = nn.Linear(width + 2 * half, width)
+
+    def forward(self, z_share: Tensor) -> tuple[Tensor, Tensor, Tensor]:
+        """Return ``(fused, aux_arm, aux_hand)``.
+
+        - ``fused``: (B, T, W) — projected back to expert width.
+        - ``aux_arm``: (B, T, max_action_dim) — auxiliary arm sub-action prediction.
+        - ``aux_hand``: (B, T, max_action_dim) — auxiliary hand sub-action prediction.
+        """
+        z_arm = self.arm_mlp(z_share)
+        z_hand = self.hand_mlp(z_share)
+        fused = torch.cat([z_share, z_arm, z_hand], dim=-1)
+        fused = self.main_proj(fused)
+        aux_arm = self.aux_arm(z_arm)
+        aux_hand = self.aux_hand(z_hand)
+        return fused, aux_arm, aux_hand
+
+
 class PI0Pytorch(nn.Module):  # see openpi `PI0Pytorch`
     """Core PI0 PyTorch model."""
 
